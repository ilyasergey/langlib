// Use values from one array as indices into another: category 1 occurs twice.
// Usage: lake exe turpentine exec --via javagen Langlib/Examples/Turpentine/array-histogram.turp
var answer : int;
var data : int[4];
var counts : int[3];
var i : int;
data[0] := 1;
data[1] := 0;
data[2] := 1;
data[3] := 2;
while i < len(data) {
  counts[data[i]] := counts[data[i]] + 1;
  i := i + 1;
}
answer := counts[1];
