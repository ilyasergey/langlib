// Conformance suite: insertion sort of eight numbers, printed in order.
// Array reads and writes at computed indices on both sides of an
// assignment, which is the operation subleq has no addressing mode for.
var a : int[8];
var i : int;
var j : int;
var t : int;
a[0] := 5; a[1] := 2; a[2] := 9; a[3] := 1;
a[4] := 5; a[5] := 6; a[6] := 0; a[7] := 7;
i := 1;
while i < 8 {
  j := i;
  while j > 0 && a[j - 1] > a[j] {
    t := a[j - 1];
    a[j - 1] := a[j];
    a[j] := t;
    j := j - 1;
  }
  i := i + 1;
}
i := 0;
while i < 8 {
  println(a[i]);
  i := i + 1;
}
