// Conformance suite: FizzBuzz to 20.
// Exercises modulo, an `else if` chain and mixed string and integer
// printing in one loop.
var i : int := 1;
while i <= 20 {
  if i % 15 == 0 {
    println("FizzBuzz");
  } else if i % 3 == 0 {
    println("Fizz");
  } else if i % 5 == 0 {
    println("Buzz");
  } else {
    println(i);
  }
  i := i + 1;
}
