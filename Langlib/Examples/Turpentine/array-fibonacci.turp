// Fill a table with the first six positive Fibonacci numbers; the last is 8.
// Usage: lake exe turpentine exec --via javagen Langlib/Examples/Turpentine/array-fibonacci.turp
var answer : int;
var fib : int[6];
var i : int;
fib[0] := 1;
fib[1] := 1;
while i + 2 < len(fib) {
  fib[i + 2] := fib[i] + fib[i + 1];
  i := i + 1;
}
answer := fib[5];
