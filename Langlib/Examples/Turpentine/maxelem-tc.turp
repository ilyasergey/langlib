// Largest of eight numbers held in an array, in the certified fragment: 9.
//
// TC-friendly twin of maxelem.turp, which reads the numbers and prints the
// answer. Here they are baked in and the result is left in `answer`.
//
// Compiles with --tc: arrays are in the fragment now. See
// docs/certified-compilation.md section 4b.
var answer : int;
var a : int[8];
var i : int;
a[0] := 3;
a[1] := 1;
a[2] := 4;
a[3] := 1;
a[4] := 5;
a[5] := 6;
a[6] := 9;
a[7] := 2;
while i < len(a) {
  if a[i] > answer {
    answer := a[i];
  }
  i := i + 1;
}
