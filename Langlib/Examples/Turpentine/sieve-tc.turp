// How many primes there are below 50, sieved with a bool array: 15.
//
// sieve.turp prints the primes themselves, which a register machine
// cannot do: it yields one number at halt. Counting them keeps the sieve
// and reduces the output to a single answer.
//
// Compiles with --tc: arrays are in the fragment now. See
// docs/certified-compilation.md section 4b.
var answer : int;
var composite : bool[50];
var p : int;
var m : int;
p := 2;
while p * p < len(composite) {
  if !composite[p] {
    m := p * p;
    while m < len(composite) {
      composite[m] := true;
      m := m + p;
    }
  }
  p := p + 1;
}
p := 2;
while p < len(composite) {
  if !composite[p] {
    answer := answer + 1;
  }
  p := p + 1;
}
