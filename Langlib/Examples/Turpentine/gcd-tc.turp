// Euclid's algorithm on 252 and 105, in the certified fragment: 21.
//
// TC-friendly twin of gcd.turp, which reads two numbers and prints the
// result. Here the inputs are baked in and the result is left in `answer`.
//
// Still blocked on: `%`. See docs/certified-compilation.md section 4b.
var answer : int;
var b : int;
var t : int;
answer := 252;
b := 105;
while b != 0 {
  t := answer % b;
  answer := b;
  b := t;
}
