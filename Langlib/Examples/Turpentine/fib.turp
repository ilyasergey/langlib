// Fibonacci: reads n, prints F(0), F(1), ..., F(n-1), one per line.
// Usage: echo 10 | lake exe turpentine run Langlib/Examples/Turpentine/fib.turp
var n : int;
var a : int := 0;
var b : int := 1;
var t : int;
var i : int := 0;
n := readInt();
while i < n {
  println(a);
  t := a + b;
  a := b;
  b := t;
  i := i + 1;
}
