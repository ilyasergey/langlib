// Euclid's algorithm: reads a and b (one per line), prints gcd(a, b).
// Usage: printf '252\n105\n' | lake exe turpentine run Langlib/Examples/Turpentine/gcd.turp
var a : int;
var b : int;
var t : int;
a := readInt();
b := readInt();
assert a >= 0 && b >= 0;
while b != 0 {
  t := a % b;
  a := b;
  b := t;
}
println(a);
