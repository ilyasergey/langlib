// Primes: reads n, prints every prime <= n by trial division.
// Usage: echo 30 | lake exe turpentine run Langlib/Examples/Turpentine/primes.turp
// Streaming output: this prints a sequence, which the certified compiler
// cannot express (a register machine yields one number at halt). Bespoke
// compilers only. See sumsq.turp for a program written for --tc.
var n : int;
var candidate : int := 2;
var d : int;
var isPrime : bool;
n := readInt();
while candidate <= n {
  isPrime := true;
  d := 2;
  while d * d <= candidate {
    if candidate % d == 0 {
      isPrime := false;
    }
    d := d + 1;
  }
  if isPrime {
    println(candidate);
  }
  candidate := candidate + 1;
}
