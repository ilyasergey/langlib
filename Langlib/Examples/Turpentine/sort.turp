// Insertion sort, ported from Velvet's InsertionSort example
// (github.com/verse-lab/velvet). Reads len(a) numbers, one per line,
// and prints them in order.
// Usage: printf '5\n2\n9\n1\n5\n6\n' | lake exe turpentine run Langlib/Examples/Turpentine/sort.turp
var a : int[6];
var i : int := 0;
var j : int;
var key : int;
while i < len(a) {
  a[i] := readInt();
  i := i + 1;
}
i := 1;
while i < len(a) {
  key := a[i];
  j := i - 1;
  while j >= 0 && a[j] > key {
    a[j + 1] := a[j];
    j := j - 1;
  }
  a[j + 1] := key;
  i := i + 1;
}
i := 0;
while i < len(a) {
  println(a[i]);
  i := i + 1;
}
