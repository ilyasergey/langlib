  -1        ri_c      ?+1       # ri_c := next input byte (-1 at EOF)
  Z         Z         L42       # goto L42
# the line must end here: a newline, or end of input (-1)
L44:
  sc        sc        ?+1       # sc := 0
  ri_c      sc        ?+1       # sc -= ri_c
  w0        w0        ?+1       # w0 := 0
  sc        w0        ?+1       # w0 := ri_c
  k10       w0        ?+1       # w0 -= k10
  Z         w0        ?+4       # if w0 <= 0, test the other side
  Z         Z         L54       # goto L54
  scj       scj       ?+1       # scj := 0
  w0        scj       ?+1       # scj -= w0
  Z         scj       L45       # if scj <= 0 goto L45
L54:
  sc        sc        ?+1       # sc := 0
  ri_c      sc        ?+1       # sc -= ri_c
  w0        w0        ?+1       # w0 := 0
  sc        w0        ?+1       # w0 := ri_c
  km1       w0        ?+1       # w0 += 1
  Z         w0        ?+4       # if w0 <= 0, test the other side
  Z         Z         L55       # goto L55
  scj       scj       ?+1       # scj := 0
  w0        scj       ?+1       # scj -= w0
  Z         scj       L45       # if scj <= 0 goto L45
L55:
  Z         Z         trap      # goto trap
L45:
  Z         ri_nd     trap      # if ri_nd <= 0 goto trap
  Z         ri_neg    L46       # if ri_neg <= 0 goto L46
  scn       scn       ?+1       # scn := 0
  ri_v      scn       ?+1       # scn -= ri_v
  sc        sc        ?+1       # sc := 0
  scn       sc        ?+1       # sc -= scn
  ri_v      ri_v      ?+1       # ri_v := 0
  sc        ri_v      ?+1       # ri_v := -ri_v
L46:
readint_exit:
  Z         Z         0         # return
