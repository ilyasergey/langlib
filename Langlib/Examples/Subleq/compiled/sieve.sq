  pi_t      pi_t      ?+1       # pi_t := 0
  sc        pi_t      ?+1       # pi_t := w1
  sc        sc        ?+1       # sc := 0
  pi_t      sc        ?+1       # sc -= pi_t
  w0        w0        ?+1       # w0 := 0
  sc        w0        ?+1       # w0 := pi_t
  pi_v      w0        ?+1       # w0 -= pi_v
  Z         w0        L38       # if w0 <= 0 goto L38
  Z         Z         L39       # goto L39
L38:
  sc        sc        ?+1       # sc := 0
  pi_t      sc        ?+1       # sc -= pi_t
  pi_p      pi_p      ?+1       # pi_p := 0
  sc        pi_p      ?+1       # pi_p := pi_t
  km1       pi_k      ?+1       # pi_k += 1
  Z         Z         L37       # goto L37
# emit pi_k digits, rebuilding 10^(k-1) each time
L39:
  Z         pi_k      L46       # if pi_k <= 0 goto L46
  pi_p      pi_p      ?+1       # pi_p := 0
  km1       pi_p      ?+1       # pi_p := 1
  pi_j      pi_j      ?+1       # pi_j := 0
  km1       pi_j      ?+1       # pi_j := 1
L40:
  sc        sc        ?+1       # sc := 0
  pi_j      sc        ?+1       # sc -= pi_j
  w0        w0        ?+1       # w0 := 0
  sc        w0        ?+1       # w0 := pi_j
  pi_k      w0        ?+1       # w0 -= pi_k
  km1       w0        ?+1       # w0 += 1
  Z         w0        L41       # if w0 <= 0 goto L41
  Z         Z         L42       # goto L42
L41:
# pi_p := 10 * pi_p
  sc        sc        ?+1       # sc := 0
  pi_p      sc        ?+1       # sc -= pi_p
  w1        w1        ?+1       # w1 := 0
  sc        w1        ?+1       # w1 := pi_p
  sc        sc        ?+1       # sc := 0
  w1        sc        ?+1       # sc -= w1
  sc        w1        ?+1       # w1 += w1
  sc        sc        ?+1       # sc := 0
  w1        sc        ?+1       # sc -= w1
  sc        w1        ?+1       # w1 += w1
  sc        sc        ?+1       # sc := 0
  pi_p      sc        ?+1       # sc -= pi_p
  sc        w1        ?+1       # w1 += pi_p
  sc        sc        ?+1       # sc := 0
  w1        sc        ?+1       # sc -= w1
  sc        w1        ?+1       # w1 += w1
  sc        sc        ?+1       # sc := 0
  w1        sc        ?+1       # sc -= w1
  pi_p      pi_p      ?+1       # pi_p := 0
  sc        pi_p      ?+1       # pi_p := w1
  km1       pi_j      ?+1       # pi_j += 1
  Z         Z         L40       # goto L40
L42:
  pi_d      pi_d      ?+1       # pi_d := 0
  km48      pi_d      ?+1       # pi_d := 48
L43:
  sc        sc        ?+1       # sc := 0
  pi_p      sc        ?+1       # sc -= pi_p
  w0        w0        ?+1       # w0 := 0
  sc        w0        ?+1       # w0 := pi_p
  pi_v      w0        ?+1       # w0 -= pi_v
  Z         w0        L44       # if w0 <= 0 goto L44
  Z         Z         L45       # goto L45
L44:
  pi_p      pi_v      ?+1       # pi_v -= pi_p
  km1       pi_d      ?+1       # pi_d += 1
  Z         Z         L43       # goto L43
L45:
  pi_d      -1        ?+1       # output the byte in pi_d
  k1        pi_k      ?+1       # pi_k -= 1
  Z         Z         L39       # goto L39
L46:
printint_exit:
  Z         Z         0         # return
