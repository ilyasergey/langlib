// Primes: reads n, prints every prime <= n by trial division.
// Usage: echo 30 | lake exe wtf run Langlib/Examples/WTF/primes.wtf
var n : int;
var candidate : int := 2;
var d : int;
var isPrime : bool;
n := readInt();
while candidate <= n
  decreases n - candidate
{
  isPrime := true;
  d := 2;
  while d * d <= candidate
    decreases candidate - d
  {
    if candidate % d == 0 {
      isPrime := false;
    }
    d := d + 1;
  }
  if isPrime {
    println(candidate);
  }
  candidate := candidate + 1;
}
